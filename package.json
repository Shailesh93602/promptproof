{
  "name": "promptproof",
  "version": "0.1.0",
  "type": "module",
  "description": "Catch LLM regressions before your users do. A tiny, zero-dependency eval + regression-diff kit: define cases, grade outputs, save a baseline, and find out if your prompt change made things worse. Runs offline in CI.",
  "keywords": [
    "llm",
    "eval",
    "evaluation",
    "prompt",
    "regression",
    "testing",
    "ai",
    "openai"
  ],
  "license": "MIT",
  "author": "Shailesh Chaudhari <shailesh93602@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shailesh93602/promptproof.git"
  },
  "homepage": "https://github.com/Shailesh93602/promptproof#readme",
  "type-note": "ESM-only, Node 18+",
  "bin": {
    "promptproof": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/cli/main.ts run src/examples/suite.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
